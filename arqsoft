// Interface comum
public interface Documento {
    void exibir();
}

// Classe real que representa o documento confidencial
class DocumentoConfidencial implements Documento {
    private String conteudo;

    public DocumentoConfidencial() {
        this.conteudo = "Conteúdo confidencial: Projeto Ultra Secreto.";
    }

    @Override
    public void exibir() {
        System.out.println(conteudo);
    }
}

// Proxy que controla o acesso ao documento
class DocumentoProxy implements Documento {
    private DocumentoConfidencial documentoReal;
    private String usuario;

    public DocumentoProxy(String usuario) {
        this.usuario = usuario;
    }

    @Override
    public void exibir() {
        if (verificarPermissao()) {
            if (documentoReal == null) {
                documentoReal = new DocumentoConfidencial();
            }
            documentoReal.exibir();
        } else {
            System.out.println("Acesso negado para o usuário: " + usuario);
        }
    }

    private boolean verificarPermissao() {
        // Apenas "admin" pode acessar o documento
        return "admin".equalsIgnoreCase(usuario);
    }
}

// Classe de teste
public class Main {
    public static void main(String[] args) {
        Documento doc1 = new DocumentoProxy("admin");
        Documento doc2 = new DocumentoProxy("joao");

        System.out.println("Usuário admin tentando acessar:");
        doc1.exibir();

        System.out.println("\nUsuário joao tentando acessar:");
        doc2.exibir();
    }
}
